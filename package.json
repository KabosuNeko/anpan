{
  "name": "anpan-cli",
  "version": "0.3.0",
  "description": "feed a link, bake a file — terminal downloader 🥐",
  "type": "module",
  "bin": {
    "anpan": "dist/entry.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "start": "node dist/entry.js",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KabosuNeko/anpan.git"
  },
  "bugs": {
    "url": "https://github.com/KabosuNeko/anpan/issues"
  },
  "homepage": "https://github.com/KabosuNeko/anpan#readme",
  "author": "KabosuNeko",
  "keywords": [
    "video",
    "downloader",
    "yt-dlp",
    "youtube",
    "instagram",
    "twitter",
    "tiktok",
    "cli",
    "tui",
    "ink",
    "anpan"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
