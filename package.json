{
  "name": "anpan",
  "version": "0.1.0",
  "description": "freshly baked video downloader for your terminal 🥐",
  "type": "module",
  "bin": {
    "anpan": "dist/entry.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/entry.js",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "author": "",
  "keywords": [
    "video",
    "downloader",
    "yt-dlp",
    "youtube",
    "instagram",
    "twitter",
    "tiktok",
    "cli",
    "tui",
    "ink",
    "anpan"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  }
}
